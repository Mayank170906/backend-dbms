# Template for a real deployment. Copy to .env.production and fill in
# real values — every placeholder below MUST be replaced; production.py
# raises at startup if SECRET_KEY or ALLOWED_HOSTS is left empty.
#
# Use with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

DJANGO_SETTINGS_MODULE=config.settings.production

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Your real domain(s), comma-separated — never "*".
ALLOWED_HOSTS=example.com,www.example.com

# Only needed if this app's own admin/API forms are POSTed to over HTTPS
# through a domain not already covered by ALLOWED_HOSTS' scheme inference.
CSRF_TRUSTED_ORIGINS=https://example.com

# Origins allowed to call this API cross-origin (leave empty if the
# frontend is served from the same origin, as it is by default here).
CORS_ALLOWED_ORIGINS=

# For Supabase or managed PostgreSQL services, use the full connection URL.
# Format: postgresql://user:password@host:port/database
# Get this from your Supabase/database provider dashboard.
DATABASE_URL=postgresql://user:password@host.supabase.co:5432/postgres

# Set only if fronting with a TLS-terminating proxy (nginx, a load
# balancer) — this is the default assumption and enables the HTTPS
# redirect. Set to False only for a deployment that genuinely has no TLS
# termination anywhere in front of it (unusual; not recommended).
SECURE_SSL_REDIRECT=True
