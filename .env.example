# Copy this file to .env and adjust values for your machine.
# .env is git-ignored; never commit real secrets.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000

# --- PostgreSQL ---
# For local development with docker-compose, these env vars are used by
# the postgres container and should match DATABASE_URL below.
# For production/remote databases, set DATABASE_URL to your provider's connection URL.
POSTGRES_DB=backend_dbms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# Local development: postgres://USER:PASSWORD@HOST:PORT/DB
# Supabase: postgresql://user:password@host.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend_dbms

# --- Redis / Celery / Cache ---
# Inside Docker Compose, use redis://redis:6379/N (service name, not
# localhost). Each consumer gets its own DB index so FLUSHDB-ing one
# (e.g. clearing the cache in development) can't touch Celery's queue or
# the notification cache/broker keyspace.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CACHE_URL=redis://localhost:6379/2
CHANNELS_REDIS_URL=redis://localhost:6379/3
